{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}